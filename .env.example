# SAP Business Accelerator Hub sandbox credentials
# Copy this file to .env and fill in your API key from:
# https://api.sap.com (Business Accelerator Hub → your sandbox application)
#
# Never commit .env — it is listed in .gitignore.

# APIKey header value for sandbox requests
SAP_API_KEY=your-api-key-here

# Sandbox OData V2 Sales Order API host (API Hub sandbox)
# Example pattern: https://sandbox.api.sap.com/s4hanacloud
SAP_BASE_URL=https://sandbox.api.sap.com/s4hanacloud

# OData service path for Sales Order (A2X)
SAP_SALES_ORDER_PATH=/sap/opu/odata/sap/API_SALES_ORDER_SRV

# HTTP request timeout in seconds
SAP_REQUEST_TIMEOUT=30

# Max retries for transient HTTP failures (5xx, timeouts, connection errors)
SAP_MAX_RETRIES=3

# DuckDB database file path (relative to project root)
DUCKDB_PATH=data/sales_analytics.duckdb
